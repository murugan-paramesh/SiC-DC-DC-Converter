   "note": "class value for reinforced digital isolators, assumption"
  },
  "ISO_BIAS": {
   "description": "gate-bias DC-DC isolation breakdown (8 x R12P21503D, basic-class part - open item 15.1-4)",
   "rate_or_prob": 8e-09,
   "mode": "detected",
   "note": "assumption"
  },
  "ISO_AMC": {
   "description": "isolated amplifier / isolated 5 V supply breakdown (3 x AMC1301 + PS9/PS10)",
   "rate_or_prob": 3.5000000000000003e-09,
   "mode": "detected",
   "note": "assumption"
  },
  "ISO_PCB": {
   "description": "PCB barrier tracking (contamination, 16 mm barrier, slots)",
   "rate_or_prob": 5e-10,
   "mode": "detected",
   "note": "assumption"
  },
  "DEV_PAD": {
   "description": "TO-247 insulating pad breakdown to the earthed heatsink (8 pads)",
   "rate_or_prob": 4e-09,
   "mode": "latent",
   "note": "assumption; revealed by hipot/PE test"
  },
  "PE_BOND": {
   "description": "PE bonding of heatsinks / chassis open (3 lugs, bonded through chassis)",
   "rate_or_prob": 5e-09,
   "mode": "latent",
   "note": "assumption; revealed by bonding test"
  },
