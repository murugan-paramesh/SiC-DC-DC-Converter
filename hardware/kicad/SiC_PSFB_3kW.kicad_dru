(version 1)
# Generated by tools/kicad/gen_pcb.py - clearance classes by net name. Later rules take precedence.
# Isolation: reinforced 8 mm primary<->secondary; 5.5 mm + milled slot at the SIP-7 bias modules.
(rule "sec_power"
